# Copy to deploy/.env.full, replace all change-me values, and keep it untracked.
# Production must pin every image to an approved digest.

RAG_APP_IMAGE=local/lazytt-rag-service:dev
# 127.0.0.1 仅本机可访问；0.0.0.0 允许受信局域网访问 Gateway API。
# 正常启动请在 .env.ragflow 配置，.env.full 会由脚本重新生成。
RAG_APP_BIND_ADDRESS=127.0.0.1
RAG_APP_PORT=8080
WORKER_CONCURRENCY=2
RAG_STORAGE_MODE=local
RAG_DOCKER_NETWORK=lazytt-ragflow-poc_ragflow-backplane
APP_POSTGRES_IMAGE=postgres:18.4-bookworm
APP_POSTGRES_DATABASE=rag_app
APP_POSTGRES_USER=rag_app
APP_POSTGRES_PASSWORD=change-me-app-postgres
APP_DATABASE_DSN=postgresql+psycopg://rag_app:change-me-app-postgres@app-postgres:5432/rag_app
REDIS_STACK_IMAGE=redis/redis-stack-server:7.4.0-v8
REDIS_STACK_PASSWORD=change-me-redis-stack
REDIS_STACK_MAXMEMORY=1gb
REDIS_STACK_HOST=redis-stack
REDIS_STACK_PORT=6379
APP_REDIS_URL=redis://:change-me-redis-stack@redis-stack:6379/2
CACHE_REDIS_URL=redis://:change-me-redis-stack@redis-stack:6379/0

RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
RAGFLOW_PLATFORM=linux/amd64
RAGFLOW_WEB_PORT=8081
RAGFLOW_API_PORT=9380
RAGFLOW_ADMIN_PORT=9381
RAGFLOW_POSTGRES_IMAGE=postgres:18.4-bookworm
RAGFLOW_POSTGRES_DATABASE=rag_flow
RAGFLOW_POSTGRES_USER=rag_flow
RAGFLOW_POSTGRES_PASSWORD=change-me-ragflow-postgres
ELASTICSEARCH_IMAGE=elasticsearch:8.11.3
ELASTIC_PASSWORD=change-me-elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g
MINIO_IMAGE=pgsty/minio:RELEASE.2026-03-25T00-00-00Z
MINIO_USER=ragflow
MINIO_PASSWORD=change-me-minio
RAGFLOW_BASE_URL=http://ragflow-server:9380
RAGFLOW_POSTGRES_HOST=ragflow-postgres
RAGFLOW_POSTGRES_PORT=5432
RAGFLOW_ES_SCHEME=http
RAGFLOW_ES_HOST=elasticsearch
RAGFLOW_ES_PORT=9200
RAGFLOW_MINIO_HOST=minio
RAGFLOW_MINIO_PORT=9000
# 仅适用于 UI/API 绑定 127.0.0.1 的本地开发 Profile；生产环境不要照搬。
RAGFLOW_REGISTER_ENABLED=1
RAGFLOW_ADMIN_EMAIL=admin@lazytt.io
RAGFLOW_ADMIN_PASSWORD=change-me-local-admin
# 首次执行 deploy/start-full.sh 时会通过官方 API 自动创建并写入私有环境文件。
RAGFLOW_API_KEY=change-me-ragflow-api-key
RAGFLOW_EMBEDDING_MODEL=pending-model-bootstrap
RAGFLOW_VISION_RUNTIME_MODEL=pending-model-bootstrap
RAGFLOW_VISION_MODEL=pending-model-bootstrap

# 临时直连身份模式；业务 API 必须携带 X-Tenant-ID 与 X-User-ID。

# 按能力配置通用三元组；每组固定按照 BASE_URL、API_KEY、MODEL 排列。
# 此文件通常由 prepare_local_env.py 自动生成，不建议手工维护。

# Chat 与 Query Rewrite
LLM_BASE_URL=https://models.example/v1
LLM_API_KEY=change-me-llm-key
LLM_MODEL=chat-model-name
# 留空时复用 LLM_MODEL；只有需要独立 Rewrite 模型时才填写。
REWRITE_MODEL=
LLM_OMIT_SAMPLING_PARAMETERS=false
LLM_MAX_OUTPUT_TOKENS_FIELD=max_tokens
LLM_EXTRA_BODY_JSON={}

# Embedding 与语义缓存
EMBEDDING_BASE_URL=https://models.example/v1
EMBEDDING_API_KEY=change-me-embedding-key
EMBEDDING_MODEL=embedding-model-name
EMBEDDING_DIMENSION=pending-auto-detection

# 图片理解与 OCR
VISION_BASE_URL=https://models.example/v1
VISION_API_KEY=change-me-vision-key
VISION_MODEL=vision-model-name

# 视频抽帧理解
MEDIA_VISION_BASE_URL=https://models.example/v1
MEDIA_VISION_API_KEY=change-me-media-vision-key
MEDIA_VISION_MODEL=media-vision-model-name

# Cross-Encoder Rerank
RERANK_ENABLED=true
RERANK_BASE_URL=https://models.example/v1
RERANK_API_KEY=change-me-rerank-key
RERANK_MODEL=rerank-model-name

# 音视频 ASR；启用后媒体视觉与 ASR 两组三元组都必须完整。
MEDIA_PROCESSING_ENABLED=true
ASR_BASE_URL=https://models.example/v1
ASR_API_KEY=change-me-asr-key
ASR_MODEL=asr-model-name

BUILD_COMMIT=local
BUILD_TIME=
TZ=Asia/Shanghai

# 仅供显式 smoke Compose Profile 使用，不属于正常开发模型配置。
RAGFLOW_SMOKE_EMBEDDING_IMAGE=python:3.12-alpine
RAGFLOW_SMOKE_EMBEDDING_BASE_URL=http://ragflow-smoke-embedding:8080/v1
