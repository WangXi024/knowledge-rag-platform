# Merge these values into the environment used by the pinned RAGFlow deployment.
# Never reuse the rag_app account or database.
DB_TYPE=postgres
RAGFLOW_POSTGRES_IMAGE=postgres:18.4-bookworm
POSTGRES_DBNAME=rag_flow
POSTGRES_USER=rag_flow
POSTGRES_PASSWORD=change-ragflow-postgres-me
POSTGRES_HOST=ragflow-postgres
POSTGRES_PORT=5432
