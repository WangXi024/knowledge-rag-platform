# RAGFlow v0.26.4 PostgreSQL/Apple Silicon pre-environment.
# Copy to deploy/local/.env.ragflow, fill each enabled model capability's generic
# BASE_URL/API_KEY/MODEL fields, and never commit it. start-full.sh replaces the
# seven password placeholders and discovers non-sensitive model details automatically.

RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
RAGFLOW_PLATFORM=linux/amd64
RAGFLOW_WEB_PORT=8081
RAGFLOW_API_PORT=9380

# Gateway 默认只能从本机访问。只有确实需要让同一受信 Wi-Fi/局域网的
# 其他主机调用 API 时才改为 0.0.0.0；该选项不会开放 RAGFlow 8081。
RAG_APP_BIND_ADDRESS=127.0.0.1

# 存储默认由独立 docker-compose.storage.yml 启动。未来切换局域网数据库服务器时，
# 改为 external 并填写下方连接地址；业务代码和运行时 Compose 都无需修改。
RAG_STORAGE_MODE=local
RAG_DOCKER_NETWORK=lazytt-ragflow-poc_ragflow-backplane

# 仅 RAG_STORAGE_MODE=external 时必须填写。示例值不含真实密码，禁止提交私有配置。
# APP_DATABASE_DSN=postgresql+psycopg://rag_user:<PASSWORD>@192.168.31.2:5432/rag_app
# 外部 Redis Stack 也是一个物理实例：DB 0=缓存、DB 1=RAGFlow、DB 2=Celery。
# REDIS_STACK_HOST=192.168.31.2
# REDIS_STACK_PORT=6379
# RAGFLOW_POSTGRES_HOST=192.168.31.2
# RAGFLOW_POSTGRES_PORT=5432
# RAGFLOW_ES_SCHEME=http
# RAGFLOW_ES_HOST=192.168.31.2
# RAGFLOW_ES_PORT=9200
# RAGFLOW_MINIO_HOST=192.168.31.2
# RAGFLOW_MINIO_PORT=9000

# 临时联调身份：业务请求必须携带 X-Tenant-ID 与 X-User-ID，不做身份鉴别。

# 以下四个镜像字段只供 RAG_STORAGE_MODE=local 使用。external 模式可以把它们
# 整行删除；远端服务器的安装版本由其自身运维配置管理，不属于 RAG 连接配置。
# 一个 PostgreSQL 实例承载两个逻辑数据库。管理员账号只用于首次创建数据库；
# Gateway 与 RAGFlow 分别使用下方两个非管理员账号，不能连接对方数据库。
POSTGRES_IMAGE=postgres:18.4-bookworm
POSTGRES_ADMIN_USER=lazytt_postgres_admin
POSTGRES_ADMIN_PASSWORD=change-me-auto-generated
APP_POSTGRES_DATABASE=rag_app
APP_POSTGRES_USER=rag_app
APP_POSTGRES_PASSWORD=change-me-auto-generated
RAGFLOW_POSTGRES_DATABASE=rag_flow
RAGFLOW_POSTGRES_USER=rag_flow
# 这些基础设施密码和后面的 RAGFlow 管理员密码无需手工填写。首次执行
# deploy/local/start-full.sh 时会分别生成不同的随机值；后续启动永不轮换。
RAGFLOW_POSTGRES_PASSWORD=change-me-auto-generated

ELASTICSEARCH_IMAGE=elasticsearch:8.11.3
ELASTIC_PASSWORD=change-me-auto-generated
ES_JAVA_OPTS=-Xms1g -Xmx1g

MINIO_IMAGE=pgsty/minio:RELEASE.2026-03-25T00-00-00Z
MINIO_USER=ragflow
MINIO_PASSWORD=change-me-auto-generated

# Redis Stack 同时提供普通 Redis 与 RediSearch。该密码由首次启动生成，
# 三个逻辑 DB 共用鉴权；生产环境应再通过 ACL 强化。
REDIS_STACK_IMAGE=redis/redis-stack-server:7.4.0-v8
REDIS_STACK_PASSWORD=change-me-auto-generated
REDIS_STACK_MAXMEMORY=1gb
REDIS_STACK_HOST=redis-stack
REDIS_STACK_PORT=6379

TZ=Asia/Shanghai

# Local RAGFlow service account and stable API key. Keep the fixed LazyTT email,
# leave both password/API key placeholders untouched: start-full.sh generates the
# password once, registers/logs in through official APIs, and writes the verified
# API key back without rotating the generated password on later starts.
RAGFLOW_ADMIN_EMAIL=admin@lazytt.io
RAGFLOW_ADMIN_PASSWORD=change-me-auto-generated
RAGFLOW_API_KEY=

# 下面按模型能力分组配置通用三元组，不写供应商专用字段。每组固定按照
# BASE_URL、API_KEY、MODEL 排列；同一 Key 被复用时仍应分别填入对应字段。

# Chat 与 Query Rewrite
LLM_BASE_URL=https://models.example/v1
LLM_API_KEY=change-me-llm-key
LLM_MODEL=chat-model-name
# 留空时 Query Rewrite 自动复用 LLM_MODEL；只有确实要拆分模型时才填写。
REWRITE_MODEL=
LLM_OMIT_SAMPLING_PARAMETERS=false
LLM_MAX_OUTPUT_TOKENS_FIELD=max_tokens
LLM_EXTRA_BODY_JSON={}

# Embedding 与语义缓存
EMBEDDING_BASE_URL=https://models.example/v1
EMBEDDING_API_KEY=change-me-embedding-key
EMBEDDING_MODEL=embedding-model-name
# 留空或使用 pending-auto-detection；首次真实探测会写回实际维度。
EMBEDDING_DIMENSION=pending-auto-detection

# 图片理解与 OCR
VISION_BASE_URL=https://models.example/v1
VISION_API_KEY=change-me-vision-key
VISION_MODEL=vision-model-name

# 视频抽帧理解；可以显式填写与文档 OCR 相同的地址和 Key，但模型职责保持独立。
MEDIA_VISION_BASE_URL=https://models.example/v1
MEDIA_VISION_API_KEY=change-me-media-vision-key
MEDIA_VISION_MODEL=media-vision-model-name

# Cross-Encoder Rerank；POST /rerank 是项目约定协议，不是 OpenAI 官方标准。
RERANK_ENABLED=true
RERANK_BASE_URL=https://models.example/v1
RERANK_API_KEY=change-me-rerank-key
RERANK_MODEL=rerank-model-name

# 音视频 ASR；启用后还必须同时配置上面的独立媒体视觉三元组。
# input_audio 是项目约定协议，不是 OpenAI 官方统一标准。
MEDIA_PROCESSING_ENABLED=true
ASR_BASE_URL=https://models.example/v1
ASR_API_KEY=change-me-asr-key
ASR_MODEL=asr-model-name

# 以下三项由 Bootstrap 通过 RAGFlow 官方 API 生成并写回，请勿手工拼接。
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_VISION_RUNTIME_MODEL=
RAGFLOW_VISION_MODEL=

# Contract-only fixture. It is never selected by the normal development
# profile and is started only through the explicit `smoke` Compose profile.
RAGFLOW_SMOKE_EMBEDDING_IMAGE=python:3.12-alpine
RAGFLOW_SMOKE_EMBEDDING_BASE_URL=http://ragflow-smoke-embedding:8080/v1

# 可选 MinerU 云端解析：仅适配服务读取 Token；未使用时保持空值。
MINERU_CLOUD_API_TOKEN=''
MINERU_CLOUD_MODEL=vlm

# 本地摄取 Worker 并发；生成 .env.full 后由 Compose 注入。
WORKER_CONCURRENCY=10
# 官网在途请求与下载/解压结果分别限流，结果处理不要盲目跟随请求并发增加。
MINERU_CLOUD_MAX_CONCURRENCY=10
MINERU_CLOUD_RESULT_CONCURRENCY=2
RAGFLOW_MAX_CONCURRENT_TASKS=10
RAGFLOW_MAX_CONCURRENT_CHUNK_BUILDERS=10
