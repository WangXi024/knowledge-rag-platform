# 复制为同目录 .env 后填写。下面全部是演练占位符，禁止提交真实密码。
# 同名连接变量需与 ../.env.ragflow 的实际值对齐；两份配置不会自动合并。
# PostgreSQL 这里只配置启动空实例所需的演练 DBA；业务角色、业务库和表必须由 DBA 手工创建。
POSTGRES_ADMIN_USER=lab_postgres_admin
POSTGRES_ADMIN_PASSWORD=change-me-lab-postgres-admin
# 同一实例供两个业务库使用；此处为宿主机映射端口，容器内仍为 5432。
RAGFLOW_POSTGRES_PORT=15432

REDIS_STACK_PASSWORD=change-me-lab-redis
REDIS_STACK_PORT=16379

ELASTIC_PASSWORD=change-me-lab-elasticsearch
RAGFLOW_ES_PORT=19200

MINIO_USER=lazytt_rag
MINIO_PASSWORD=change-me-lab-minio
RAGFLOW_MINIO_PORT=19000
# 控制台端口仅供本机管理，RAG Runtime 只连接上面的 API 端口。
MINIO_CONSOLE_PORT=19001
