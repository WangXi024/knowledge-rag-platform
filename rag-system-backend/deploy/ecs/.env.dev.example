# 复制到 ECS /etc/lazytt/rag.env，root:root 0600。仅管理员编辑。
# 当前 workflow 用 source 读取此文件；export 让 Python、Docker 子进程继承这些变量。
# 修改真实配置后需重新 release 重建容器；仅 restart 不会加载新环境变量。
# <> 是待填写占位符；真实密码和 API Key 只填在 ECS 文件中，不打印或提交到 Git。
# RAG_APP_IMAGE 与 BUILD_COMMIT 由候选命令固化，不在本文件另存一份。
# 模型名称、公开端点、维度、兼容参数和功能开关与 2026-09-07 本机运行配置对齐。
# 真实 API Key/密码仍需在 ECS 填写；本机存储地址及映射端口不作为 ECS 默认值。

# 首次部署：prepare → 建库/迁移/验收 → init-ragflow → bootstrap-account
# → bootstrap-models → 关闭注册 → release。完整命令见同目录 README.md。
# 模型平台 API Key 由管理员填写；RAGFlow API Key 由账号初始化程序获取并写回。

# ---------- RAGFlow 镜像与注册开关 ----------
# 两个 RAGFlow 服务共用此镜像；填写经核实的 v0.26.4 linux/amd64 完整 digest。
# digest 占位符不能替换为 :v0.26.4 标签或 docker images 中的短 IMAGE ID。
export RAGFLOW_IMAGE='ghcr.io/lazyaix/ragflow@sha256:<REVIEWED_V0_26_4_AMD64_DIGEST>'
# 0 关闭新账号注册，已有账号仍可使用；1 开放注册。
# 首次创建账号时，在 init-ragflow 前临时改为 1；账号创建完成后改回 0，再 release。
export RAGFLOW_REGISTER_ENABLED=0

# ---------- PostgreSQL：RAGFlow 元数据 ----------
# HOST 填容器可访问的 IP/域名，不带协议或端口，也不能填容器内的 127.0.0.1。
# PORT 填共享服务实际端口。使用业务库 rag_flow 和业务角色，独立密码字段填原值。
export RAGFLOW_POSTGRES_HOST='<PG_HOST>'
export RAGFLOW_POSTGRES_PORT='<PG_PORT>'
export RAGFLOW_POSTGRES_DATABASE=rag_flow
export RAGFLOW_POSTGRES_USER=lazytt_rag
export RAGFLOW_POSTGRES_PASSWORD='<REDACTED>'

# ---------- Elasticsearch：文档索引与检索 ----------
# SCHEME 与服务实际协议一致；HOST 不带协议/端口，PORT 默认 9200，按实际映射调整。
# USER/PASSWORD 填已获 RAG 索引权限的身份；这里不会创建账号或配置共享服务权限。
export RAGFLOW_ES_SCHEME=http
export RAGFLOW_ES_HOST='<ES_HOST>'
export RAGFLOW_ES_PORT=9200
export RAGFLOW_ES_USER='<ES_USER>'
export ELASTIC_PASSWORD='<REDACTED>'

# ---------- MinIO：文件与解析产物 ----------
# PORT 是对象存储 API 端口（通常 9000），不是管理控制台端口。
# USER/PASSWORD 分别是 RAG 专用 Access Key / Secret Key，Bucket 配置见下方。
export RAGFLOW_MINIO_HOST='<MINIO_HOST>'
export RAGFLOW_MINIO_PORT=9000
export MINIO_USER='<RAG_MINIO_ACCESS_KEY>'
export MINIO_PASSWORD='<REDACTED>'

# ---------- Redis Stack：RAGFlow 队列与状态 ----------
# 必须使用支持 RediSearch 的 Redis Stack；HOST/PORT 按容器可达的实际地址填写。
# RAGFlow 使用 DB 1；其用户名在下方 RAGFLOW_REDIS_USERNAME 配置。
export REDIS_STACK_HOST='<REDIS_STACK_HOST>'
export REDIS_STACK_PORT=6379
export REDIS_STACK_PASSWORD='<REDACTED>'

# ---------- 时区与 RAGFlow 补充配置 ----------
# 容器时区，用于时间显示及日志定位。
export TZ=Asia/Shanghai
# 先由存储管理员创建并授权 RAG 专用 Bucket；不需要对象路径前缀时留空。
export RAGFLOW_MINIO_BUCKET='<RAG_DEDICATED_BUCKET>'
export RAGFLOW_MINIO_PREFIX_PATH=''
# 使用 Redis 默认用户可留空；使用专用 ACL 用户时填写已授权用户名及对应密码。
export RAGFLOW_REDIS_USERNAME=''
# RAGFlow 每个进程的 PostgreSQL 连接池上限；多进程会放大总连接数。
export RAGFLOW_PG_POOL_SIZE=20
# 执行器容器另受 Compose 中 4 核、8 GiB 的资源上限约束。
# 执行器同时处理的文档任务上限；超过上限的任务不会立即并行执行。
export RAGFLOW_MAX_CONCURRENT_TASKS=10
# 切片构建和向量生成阶段各自的并发上限，不控制 Celery Worker 数量。
export RAGFLOW_MAX_CONCURRENT_CHUNK_BUILDERS=10
# 宿主机回环 API 端口：127.0.0.1:19381 → RAGFlow 容器 9380，不开放 UI/Admin 端口。
export RAGFLOW_API_PORT=19381

# ---------- 自研后端：数据库与 Redis ----------
# 连接业务库 rag_app；账号/地址/端口须独立填完整，不会从上方变量自动拼接。
# URL 内的密码需百分号编码，例如密码中的 @ 编码为 %40；独立密码字段仍填原值。
export APP_DATABASE_DSN='postgresql+psycopg://lazytt_rag:<REDACTED_URL_ENCODED>@47.108.210.233:5432/rag_app'
# DB 2 用于 Celery 队列，DB 0 用于语义缓存/RediSearch；URL 内密码同样需编码。
# 用户名按实际 ACL 填写；逻辑 DB 编号本身不提供账号权限隔离。
export APP_REDIS_URL='redis://:<REDACTED_URL_ENCODED>@47.108.210.233:6379/2'
export CACHE_REDIS_URL='redis://:<REDACTED_URL_ENCODED>@47.108.210.233:6379/0'

# ---------- 自研后端访问 RAGFlow ----------
# Compose 内部服务地址，保持容器端口 9380；不要改成宿主机的 19381 或 localhost。
export RAGFLOW_BASE_URL=http://ragflow-server:9380
# 首次可留空：bootstrap-account 登录/注册账号，复用或创建 Key，并自动写回 ECS 文件。
# 它与下方模型平台 Key 不同；正式 release 前必须已生成，普通 release 不负责补生成。
export RAGFLOW_API_KEY=''

# ---------- RAGFlow 模型登记结果 ----------
# 模型引用与维度是本机已验证基准；ECS 首次仍须 bootstrap-models 注册并验证，
# 不能仅靠预填值跳过初始化。切换端点或模型后，引用与维度由该工具重新写回。
# 前两个值包含模型、实例和 Provider；RUNTIME_MODEL 是 Vision 供应商的实际模型名。
export RAGFLOW_EMBEDDING_MODEL=BAAI/bge-m3@lazytt-embedding-baai-bge-m3-062cbcee44@OpenAI-API-Compatible
export RAGFLOW_VISION_MODEL=qwen3.5-ocr@lazytt-vision-qwen3-5-ocr-d25e65378a@OpenAI-API-Compatible
export RAGFLOW_VISION_RUNTIME_MODEL=qwen3.5-ocr

# ---------- 问答与查询改写模型 ----------
# BASE_URL 填 API 基础路径，不追加 /chat/completions；API_KEY 填模型平台实际密钥。
export LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export LLM_API_KEY='<REDACTED>'
export LLM_MODEL=qwen3.7-flash
# 改写检索问题所用模型；当前与问答模型一致，留空时也会使用 LLM_MODEL。
export REWRITE_MODEL=qwen3.7-flash
# 以下由 bootstrap-models 探测并写回：是否省略采样参数、输出 Token 字段及额外 JSON。
# false 表示保留采样参数；{} 表示没有额外请求参数，JSON 用单引号包裹。
export LLM_OMIT_SAMPLING_PARAMETERS=false
export LLM_MAX_OUTPUT_TOKENS_FIELD=max_tokens
export LLM_EXTRA_BODY_JSON='{}'

# ---------- Embedding：文档向量与语义缓存 ----------
# BASE_URL 填 API 基础路径，不追加 /embeddings；密钥必须显式填写。
export EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
export EMBEDDING_API_KEY='<REDACTED>'
export EMBEDDING_MODEL=BAAI/bge-m3
# 1024 是本机探测值，ECS 初始化仍会验证；模型或维度变化时不能继续混写旧索引。
export EMBEDDING_DIMENSION=1024

# ---------- 文档图片识别与 OCR ----------
# 此组供文档图片解析使用，当前 release 必填；与下方音视频处理开关相互独立。
export VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export VISION_API_KEY='<REDACTED>'
export VISION_MODEL=qwen3.5-ocr

# ---------- 音视频处理：视频画面理解 ----------
# 此组分析视频抽帧；即使与文档 Vision 共用平台，也必须显式填写对应 API Key。
export MEDIA_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export MEDIA_VISION_API_KEY='<REDACTED>'
export MEDIA_VISION_MODEL=qwen3.8-max
# true 开启音视频预处理，要求 MEDIA_VISION 与 ASR 两组配置完整；false 时两组可空。
export MEDIA_PROCESSING_ENABLED=true

# ---------- 音视频处理：语音转写 ----------
# 此组识别音频/视频中的语音；MEDIA_PROCESSING_ENABLED=true 时必填。
export ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export ASR_API_KEY='<REDACTED>'
export ASR_MODEL=qwen3-asr-flash

# ---------- 检索结果重排 ----------
# true 调用重排模型，要求下方三项完整；false 时三项可空，并使用融合检索排序。
export RERANK_ENABLED=true
# BASE_URL 填支持本项目 /rerank 协议的 API 基础路径，不追加 /rerank。
export RERANK_BASE_URL=https://api.siliconflow.cn/v1
export RERANK_API_KEY='<REDACTED>'
export RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 自研后端入口与容量 ----------
# 应用配置中的访问地址；当前为宿主机回环地址，修改此值不会改变 Compose 端口绑定。
export LAZYTT_RAG_PUBLIC_BASE_URL=http://127.0.0.1:19380
# 每个进程的常规连接池大小与额外连接上限；总连接预算还需考虑 Worker 等进程数。
export LAZYTT_RAG_DB_POOL_SIZE=5
export LAZYTT_RAG_DB_MAX_OVERFLOW=5
# 宿主机回环 Gateway 端口：127.0.0.1:19380 → 应用容器 8080。
export RAG_APP_PORT=19380
# 默认仅本机访问；经管理员确认来源访问控制后，开发公网 Gateway 可显式填 0.0.0.0。
# 此值不提供身份认证，也不影响 RAGFlow API 的回环绑定。
export RAG_GATEWAY_BIND_HOST=127.0.0.1
# Celery 同时执行的摄取任务数；多出的任务在队列等待，不代表 CPU 核数。
# Worker 容器仍限 2 核、2 GiB；增加并发会提高内存和数据库连接占用。
export WORKER_CONCURRENCY=10

# 可选 MinerU 官网 VLM 解析；留空跳过，填写后 release 自动启动并注册。
# 真实 Token 只填写在 ECS /etc/lazytt/rag.env，不配置为 GitHub Secret。
export MINERU_CLOUD_API_TOKEN=''
export MINERU_CLOUD_MODEL=vlm

# 适配器同时接收的解析请求数；达到上限会返回忙，不在适配器内排队。
export MINERU_CLOUD_MAX_CONCURRENCY=10
# 同时下载并解压官网解析结果的数量；限制结果处理阶段的内存峰值。
export MINERU_CLOUD_RESULT_CONCURRENCY=2
